{
  "name": "dsh-a11y",
  "version": "0.1.0",
  "description": "Accessibility layer for the DeepSeek Harness Web UI: coordinated announcements, keyboard navigation, and accessibility settings.",
  "type": "module",
  "license": "MIT",
  "author": "Andrei Dumitriu",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "accessibility",
    "screen-reader",
    "wcag"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tespio/dsh-a11y.git"
  },
  "homepage": "https://github.com/tespio/dsh-a11y#readme",
  "bugs": {
    "url": "https://github.com/tespio/dsh-a11y/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "test/*.mjs"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
